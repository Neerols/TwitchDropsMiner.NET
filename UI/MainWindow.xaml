<Window x:Class="TwitchDropsMiner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:TwitchDropsMiner.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:MainViewModel}"
        Title="Twitch Drops Miner"
        Width="1280" Height="900" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Icons/pickaxe.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ui:StatusBrushConverter x:Key="StatusBrush" />
        <ui:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Секция-«карточка» вместо стандартного GroupBox -->
        <Style x:Key="Section" TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,4,12,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="12,8,12,2"
                                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,8,2" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <!-- Элемент списка без выделения -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,0,4,6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактная карточка кампании для главной вкладки -->
        <DataTemplate x:Key="CompactCampaign" DataType="{x:Type ui:CampaignView}">
            <Border x:Name="Card" CornerRadius="6" BorderThickness="1" Padding="8"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="45" Height="60" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding GameName}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Name}" Opacity="0.9" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTooltip}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock FontSize="12">
                            <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding LinkUrl}"
                                       Foreground="{Binding LinkKind, Converter={StaticResource StatusBrush}}">
                                <Run Text="{Binding LinkText, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Drops}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:DropView}">
                                <Border x:Name="DropCard" CornerRadius="5" BorderThickness="1" Padding="5" Margin="0,0,5,5" Width="142"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Benefits}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:BenefitView}">
                                                    <StackPanel Width="132" Margin="1" ToolTip="{Binding Name}">
                                                        <Image Source="{Binding Image}" Width="34" Height="34" />
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                                                                   FontWeight="SemiBold" MaxHeight="32" LineStackingStrategy="BlockLineHeight" LineHeight="15" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,4" />
                                        <TextBlock Text="{Binding ProgressText}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{Binding ProgressKind, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="DropCard" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="DropCard" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- ======================= ГЛАВНАЯ ======================= -->
            <TabItem Header="{ui:Tr gui.tabs.main, Default=Main}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="250" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <!-- Статус -->
                    <Border Grid.Row="0" Margin="4" Padding="12,8" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{ui:Tr gui.tray.minimize, Default=Minimize to Tray}"
                                    Command="{Binding MinimizeCommand}" Padding="10,3" />
                            <TextBlock DockPanel.Dock="Left" Text="{ui:Tr gui.status.name, Default=Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <!-- Верх: слева прогресс/вход/websocket, справа каналы -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Прогресс кампании -->
                                <GroupBox Style="{StaticResource Section}" Header="{ui:Tr gui.progress.name, Default=Campaign Progress}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr gui.progress.game, Default=Game:}" />
                                            <TextBlock Grid.Column="1" Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{ui:Tr gui.progress.campaign, Default=Campaign:}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CampaignName}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CampaignPercent}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr gui.progress.campaign_progress, Default=Progress:}" />
                                        </DockPanel>
                                        <ProgressBar Maximum="1" Value="{Binding CampaignProgress, Mode=OneWay}" Height="8" Margin="0,2" />
                                        <TextBlock Text="{Binding CampaignRemaining}" FontFamily="Cascadia Mono, Consolas" Opacity="0.8" HorizontalAlignment="Right" />

                                        <Separator Margin="0,6" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{ui:Tr gui.progress.drop, Default=Drop:}" />
                                            <TextBlock Text="{Binding DropRewards}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DropPercent}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr gui.progress.drop_progress, Default=Progress:}" />
                                        </DockPanel>
                                        <ProgressBar Maximum="1" Value="{Binding DropProgress, Mode=OneWay}" Height="8" Margin="0,2" />
                                        <TextBlock Text="{Binding DropRemaining}" FontFamily="Cascadia Mono, Consolas" Opacity="0.8" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- Websocket -->
                                <GroupBox Style="{StaticResource Section}" Header="{ui:Tr gui.websocket.name, Default=Websocket Status}">
                                    <ItemsControl ItemsSource="{Binding Websockets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Opacity="0.8" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Topics}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Авторизация (между ходом кампании и каналами, как в оригинале) -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <GroupBox Style="{StaticResource Section}" Header="{ui:Tr gui.login.name, Default=Login Form}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LoginStatus}" FontWeight="SemiBold" />
                                            <TextBlock Text="  ·  ID " Opacity="0.7" />
                                            <TextBlock Text="{Binding UserIdText}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Diagnostics}" Opacity="0.75" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   ToolTip="{ui:Tr x.diag.hint}" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <!-- не вошли: войти через браузер; вошли: выйти -->
                                            <Button Content="{ui:Tr x.browser.button}" Command="{Binding BrowserLoginCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,6" ToolTip="{ui:Tr x.browser.hint}"
                                                    Visibility="{Binding LogoutEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                            <Button Content="{ui:Tr x.logout.button}" Command="{Binding LogoutCommand}"
                                                    Margin="0,0,6,6" ToolTip="{ui:Tr x.logout.hint}"
                                                    Visibility="{Binding LogoutEnabled, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>

                        </ScrollViewer>

                        <!-- Каналы -->
                        <GroupBox Grid.Column="2" Style="{StaticResource Section}" Header="{ui:Tr gui.channels.name, Default=Channels}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Left" Content="{ui:Tr gui.channels.switch, Default=Switch}"
                                            Command="{Binding SwitchCommand}" Padding="12,3" />
                                    <TextBlock Text="{ui:Tr x.channels.hint}" Opacity="0.6" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DataGrid x:Name="ChannelsGrid" ItemsSource="{Binding Channels}"
                                          SelectedItem="{Binding SelectedChannel}"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          HeadersVisibility="Column" GridLinesVisibility="None"
                                          CanUserResizeRows="False" CanUserAddRows="False"
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                          BorderThickness="0" RowHeight="26"
                                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                            <Setter Property="Padding" Value="6,0" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridRow">
                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="0,1">
                                                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#262E86DE" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#662E86DE" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{ui:Tr gui.channels.headings.channel, Default=Channel}" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTemplateColumn Header="{ui:Tr gui.channels.headings.status, Default=Status}" Width="Auto" SortMemberPath="Status">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:Tr gui.channels.headings.game, Default=Game}" Binding="{Binding Game}" Width="2*" />
                                        <DataGridTextColumn Header="🎁" Binding="{Binding Drops}" Width="Auto" />
                                        <DataGridTextColumn Header="{ui:Tr gui.channels.headings.viewers, Default=Viewers}" Binding="{Binding Viewers}" Width="Auto" />
                                        <DataGridTextColumn Header="📋" Binding="{Binding Acl}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

                    <!-- Низ: кампании с дропами и журнал -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Style="{StaticResource Section}" Header="{ui:Tr x.main.campaigns}">
                            <ListBox ItemsSource="{Binding MainCampaignsView}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource PlainItem}"
                                     ItemTemplate="{StaticResource CompactCampaign}" />
                        </GroupBox>

                        <GroupBox Grid.Column="1" Style="{StaticResource Section}" Header="{ui:Tr gui.output, Default=Output}">
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{ui:Tr x.menu.copy}" Command="{Binding CopyLogCommand}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{ui:Tr x.menu.clear}" Command="{Binding ClearLogCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= ИНВЕНТАРЬ ======================= -->
            <TabItem Header="{ui:Tr gui.tabs.inventory, Default=Inventory}">
                <DockPanel>
                    <GroupBox DockPanel.Dock="Top" Style="{StaticResource Section}"
                              Header="{ui:Tr gui.inventory.filter.name, Default=Filter}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:Tr gui.inventory.filter.show, Default=Show:}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Content="{ui:Tr gui.inventory.filter.not_linked, Default=Not linked}" IsChecked="{Binding Filter.NotLinked}" Margin="0,0,16,0" />
                            <CheckBox Content="{ui:Tr gui.inventory.filter.upcoming, Default=Upcoming}" IsChecked="{Binding Filter.Upcoming}" Margin="0,0,16,0" />
                            <CheckBox Content="{ui:Tr gui.inventory.filter.expired, Default=Expired}" IsChecked="{Binding Filter.Expired}" Margin="0,0,16,0" />
                            <CheckBox Content="{ui:Tr gui.inventory.filter.excluded, Default=Excluded}" IsChecked="{Binding Filter.Excluded}" Margin="0,0,16,0" />
                            <CheckBox Content="{ui:Tr gui.inventory.filter.finished, Default=Finished}" IsChecked="{Binding Filter.Finished}" Margin="0,0,16,0" />
                            <Button Content="{ui:Tr gui.inventory.filter.refresh, Default=Refresh}" Command="{Binding RefreshInventoryCommand}" Padding="12,3" />
                        </WrapPanel>
                    </GroupBox>

                    <ListBox ItemsSource="{Binding CampaignsView}" Margin="4"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,0,0,8" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:CampaignView}">
                                <Border CornerRadius="8" BorderThickness="1" Padding="10"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="270" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="108" Height="144" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GameName}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding TimeText}" ToolTip="{Binding TimeTooltip}" />
                                            <TextBlock>
                                                <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding LinkUrl}"
                                                           Foreground="{Binding LinkKind, Converter={StaticResource StatusBrush}}">
                                                    <Run Text="{Binding LinkText, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AllowedText}" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Drops}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:DropView}">
                                                    <Border CornerRadius="6" BorderThickness="1" Padding="6" Margin="0,0,6,6" Width="190"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Benefits}" HorizontalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type ui:BenefitView}">
                                                                        <StackPanel Width="170" Margin="2">
                                                                            <Image Source="{Binding Image}" Width="64" Height="64" />
                                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,4" />
                                                            <TextBlock Text="{Binding ProgressText}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                                                       Foreground="{Binding ProgressKind, Converter={StaticResource StatusBrush}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ======================= НАСТРОЙКИ ======================= -->
            <TabItem Header="{ui:Tr gui.tabs.settings, Default=Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" MinWidth="460" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Общие -->
                        <GroupBox Grid.Column="0" Style="{StaticResource Section}"
                                  Header="{ui:Tr gui.settings.general.name, Default=General}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,4,10,4" />
                                    </Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="Margin" Value="0,2" />
                                    </Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="MinWidth" Value="180" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Grid.Row="0" Text="{ui:Tr x.settings.language}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                                <TextBlock Grid.Row="1" Text="{ui:Tr x.settings.theme}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ThemeNames}" SelectedIndex="{Binding ThemeIndex}" />
                                <TextBlock Grid.Row="2" Text="{ui:Tr gui.settings.general.priority_mode, Default=Priority mode:}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PriorityModeNames}" SelectedIndex="{Binding PriorityModeIndex}" />
                                <TextBlock Grid.Row="3" Text="{ui:Tr gui.settings.general.autostart, Default=Autostart:}" />
                                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding AutostartEnabled}" />
                                <TextBlock Grid.Row="4" Text="{ui:Tr gui.settings.general.tray, Default=Autostart into tray:}" />
                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding AutostartTray}" />
                                <TextBlock Grid.Row="5" Text="{ui:Tr gui.settings.general.tray_notifications, Default=Tray notifications:}" />
                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding TrayNotifications}" />
                                <TextBlock Grid.Row="6" Text="{ui:Tr x.settings.close_to_tray}" />
                                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding CloseToTray}" />
                                <TextBlock Grid.Row="7" Text="{ui:Tr x.settings.connection_quality}" TextWrapping="Wrap" MaxWidth="230" />
                                <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding ConnectionQualities}" SelectedItem="{Binding ConnectionQuality}" MinWidth="70" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{ui:Tr gui.settings.general.proxy, Default=Proxy (requires restart):}" />
                                <TextBox Grid.Row="9" Grid.ColumnSpan="2" x:Name="ProxyBox" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="ProxyBox_LostFocus" ToolTip="http://username:password@address:port  |  socks5://address:port" />
                            </Grid>
                        </GroupBox>

                        <!-- Дополнительно -->
                        <GroupBox Grid.Column="0" Grid.Row="1" Style="{StaticResource Section}"
                                  Header="{ui:Tr gui.settings.advanced.name, Default=Advanced}">
                            <StackPanel>
                                <TextBlock Text="{ui:Tr gui.settings.advanced.warning, Default=Warning!}" FontWeight="Bold"
                                           Foreground="{Binding Source={x:Static ui:StatusKind.Bad}, Converter={StaticResource StatusBrush}}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,6"
                                           Foreground="{Binding Source={x:Static ui:StatusKind.Warn}, Converter={StaticResource StatusBrush}}"
                                           Text="{ui:Tr gui.settings.advanced.warning_text, Default='These options will cause the miner to misbehave. If you are experiencing any issues, make sure all of these options are disabled.'}" />
                                <CheckBox IsChecked="{Binding EnableBadgesEmotes}" Margin="0,2">
                                    <TextBlock TextWrapping="Wrap" Text="{ui:Tr gui.settings.advanced.enable_badges_emotes, Default=Enable partial support for badges and emotes}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding BrowserPlayer}" Margin="0,2" ToolTip="{ui:Tr x.settings.player_hint}">
                                    <TextBlock TextWrapping="Wrap" Text="{ui:Tr x.settings.player}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding UseCampaignCatalog}" Margin="0,2" ToolTip="{ui:Tr x.settings.catalog_hint}">
                                    <TextBlock TextWrapping="Wrap" Text="{ui:Tr x.settings.catalog}" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding AvailableDropsCheck}" Margin="0,2">
                                    <TextBlock TextWrapping="Wrap" Text="{ui:Tr gui.settings.advanced.available_drops_check, Default=Enable extra available drops check}" />
                                </CheckBox>
                            </StackPanel>
                        </GroupBox>

                        <!-- Приоритет -->
                        <GroupBox Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Section}"
                                  Header="{ui:Tr gui.settings.priority, Default=Priority}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="➕" Command="{Binding PriorityAddCommand}" Style="{StaticResource SmallButton}" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding PriorityChoices}" Margin="0,2"
                                              Text="{Binding PriorityInput, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{ui:Tr gui.settings.game_name, Default=Game name}" />
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="4,4,0,0">
                                    <Button Content="⇈" Command="{Binding PriorityMoveCommand}" CommandParameter="2147483647" Style="{StaticResource SmallButton}" />
                                    <Button Content="↑" Command="{Binding PriorityMoveCommand}" CommandParameter="1" Style="{StaticResource SmallButton}" />
                                    <Button Content="↓" Command="{Binding PriorityMoveCommand}" CommandParameter="-1" Style="{StaticResource SmallButton}" />
                                    <Button Content="⇊" Command="{Binding PriorityMoveCommand}" CommandParameter="-2147483647" Style="{StaticResource SmallButton}" />
                                    <Button Content="❌" Command="{Binding PriorityDeleteCommand}" Style="{StaticResource SmallButton}" Margin="2,12,2,2" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding PriorityList}" SelectedItem="{Binding SelectedPriority}" MinHeight="300" Margin="0,4,0,0" />
                            </DockPanel>
                        </GroupBox>

                        <!-- Исключения -->
                        <GroupBox Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Section}"
                                  Header="{ui:Tr gui.settings.exclude, Default=Exclude}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="➕" Command="{Binding ExcludeAddCommand}" Style="{StaticResource SmallButton}" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding ExcludeChoices}" Margin="0,2"
                                              Text="{Binding ExcludeInput, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{ui:Tr gui.settings.game_name, Default=Game name}" />
                                </DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="❌" Command="{Binding ExcludeDeleteCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                                <ListBox ItemsSource="{Binding ExcludeList}" SelectedItem="{Binding SelectedExclude}" MinHeight="300" Margin="0,4,0,0" />
                            </DockPanel>
                        </GroupBox>

                        <!-- Перезагрузка -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,8">
                            <TextBlock Text="{ui:Tr gui.settings.reload_text, Default=Most changes require a reload to take an immediate effect:}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="{ui:Tr gui.settings.reload, Default=Reload}" Command="{Binding ReloadCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="16,4" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= ПОМОЩЬ ======================= -->
            <TabItem Header="{ui:Tr gui.tabs.help, Default=Help}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="0,4">
                        <GroupBox Style="{StaticResource Section}" Header="About">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Twitch Drops Miner .NET" FontWeight="Bold" /> — C#/.NET-порт приложения
                                    <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/DevilXD/TwitchDropsMiner">DevilXD/TwitchDropsMiner</Hyperlink>
                                    (MIT) и форка
                                    <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/Davixk/TwitchDropsMiner">Davixk/TwitchDropsMiner</Hyperlink>.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                                    Поддержать автора оригинала:
                                    <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://www.buymeacoffee.com/DevilXD">buymeacoffee.com/DevilXD</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Style="{StaticResource Section}" Header="{ui:Tr gui.help.links.name, Default=Useful Links}">
                            <StackPanel>
                                <TextBlock><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://www.twitch.tv/drops/inventory"><Run Text="{ui:Tr gui.help.links.inventory, Default=See Twitch inventory}" /></Hyperlink></TextBlock>
                                <TextBlock><Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://www.twitch.tv/drops/campaigns"><Run Text="{ui:Tr gui.help.links.campaigns, Default=See all campaigns and manage account links}" /></Hyperlink></TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Style="{StaticResource Section}" Header="{ui:Tr gui.help.how_it_works, Default=How It Works}">
                            <TextBlock TextWrapping="Wrap" Text="{ui:Tr x.help.how_it_works}" />
                        </GroupBox>
                        <GroupBox Style="{StaticResource Section}" Header="{ui:Tr gui.help.getting_started, Default=Getting Started}">
                            <TextBlock TextWrapping="Wrap" Text="{ui:Tr x.help.getting_started}" />
                        </GroupBox>
                        <GroupBox Style="{StaticResource Section}" Header="{ui:Tr x.data_dir}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{ui:Tr x.open_folder}" Command="{Binding OpenDataFolderCommand}" Padding="12,3" />
                                <TextBox Text="{Binding DataDir, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" />
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
